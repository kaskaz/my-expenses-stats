# Google Cloud OAuth Web application credentials (never commit real secrets).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -base64 48
SESSION_SECRET=
APP_URL=http://localhost:3000
# The native 2026 spreadsheet ID from EXTRATOS-BCN (between /d/ and /edit in its URL).
GOOGLE_SPREADSHEET_ID=
# Optional: restrict sign-in to one Google account.
ALLOWED_GOOGLE_EMAIL=
# Currency is not declared in the source tabs. Confirm before using this default.
EXPENSE_CURRENCY=CVE
